        <h2 class="section-title">Deterministic Alert Engine</h2>
        <p style="color: var(--text-muted); margin-bottom: 2rem;">
            Test the <strong>Layer 0</strong> alert checks: <em>Watchdog</em> (sensor disconnected) and <em>Vision
                Delta</em> (rapid canopy loss).
            Generate sensor data in the Sensor Lab first, then run alerts here to see the results.
        </p>
        <div class="grid grid-2">
            <div class="glass-panel">
                <h3 style="margin-bottom: 1rem;">🔎 Run Alert Checks</h3>
                <form action="/ui/alerts" method="post">
                    <div class="form-group">
                        <label>Plant / Sensor ID:</label>
                        <input type="text" name="plant_id" value="{{ alert_plant_id|default('test_plant_01') }}"
                            required placeholder="e.g. test_plant_01">
                    </div>
                    <button type="submit" class="btn">🚨 Run All Checks</button>
                </form>
                <p style="font-size: 0.8rem; color: var(--text-muted); margin-top: 1rem;">
                    Checks run: <code>check_watchdog</code> (max 130 min silence) · <code>check_vision_delta</code> (5%
                    drop in 4h)
                </p>
            </div>

            <div class="glass-panel">
                <h3 style="margin-bottom: 1rem;">📋 Alert Results</h3>
                {% if alert_results is defined and alert_results is not none %}
                {% if alert_count == 0 %}
                <div class="success-card" style="display: flex; align-items: center; gap: 0.75rem;">
                    <span style="font-size: 1.5rem;">✅</span>
                    <div>
                        <strong>All Clear</strong>
                        <p style="margin: 0; font-size: 0.85rem; opacity: 0.8;">No alerts triggered for "{{
                            alert_plant_id }}".</p>
                    </div>
                </div>
                {% else %}
                <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem;">
                    <span style="font-size: 1.25rem;">🔴</span>
                    <span style="font-weight: 600; color: #f87171;">{{ alert_count }} alert{{ 's' if alert_count > 1 }}
                        triggered</span>
                </div>
                {% for a in alert_results %}
                <div
                    style="background: rgba(248,113,113,0.08); border: 1px solid rgba(248,113,113,0.25); border-radius: 10px; padding: 1rem; margin-bottom: 0.75rem;">
                    <div
                        style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                        <span style="font-weight: 600; text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.05em;
                                background: {% if a.severity == 'critical' %}rgba(248,113,113,0.2){% else %}rgba(251,191,36,0.2){% endif %};
                                color: {% if a.severity == 'critical' %}#f87171{% else %}#fbbf24{% endif %};
                                padding: 0.2rem 0.6rem; border-radius: 999px;">
                            {{ a.alert_type }} · {{ a.severity }}
                        </span>
                        <span style="font-size: 0.75rem; color: var(--text-muted);">{{ a.triggered_at[:19] }}</span>
                    </div>
                    <p style="margin: 0; font-size: 0.9rem;">{{ a.message }}</p>
                    {% if a.details %}
                    <details style="margin-top: 0.5rem; font-size: 0.8rem; color: var(--text-muted);">
                        <summary style="cursor: pointer;">Details</summary>
                        <pre
                            style="margin-top: 0.25rem; white-space: pre-wrap; word-break: break-all;">{{ a.details }}</pre>
                    </details>
                    {% endif %}
                </div>
                {% endfor %}
                {% endif %}
                {% else %}
                <p style="color: var(--text-muted);">Run a check to see results. Make sure you've generated sensor data
                    first in the Sensor Lab.</p>
                {% endif %}
            </div>
        </div>
