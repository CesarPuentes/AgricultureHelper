        <h2 class="section-title">Sensor Telemetry Simulation</h2>
        <p style="color: var(--text-muted); margin-bottom: 2rem;">Generating a 10-day history window of fictional sensor
            data.</p>
        <div class="grid grid-2">
            <div class="glass-panel">
                <h3 style="margin-bottom: 1rem;">Simulate Data</h3>
                {% if sensor_success %}
                <div class="success-card">{{ sensor_success_msg }}</div>
                {% endif %}
                <form action="/ui/sensor" method="post">
                    <div class="form-group">
                        <label>Target Plant ID:</label>
                        <input type="text" name="plant_id" value="{{ plant_id|default('test_plant_01') }}" required>
                    </div>
                    <button type="submit" class="btn">💾 Generate & Save 10-Day History</button>
                    {% if sensor_error %}
                    <div class="alert-card" style="margin-top: 1rem;">{{ sensor_error }}</div>
                    {% endif %}
                </form>
            </div>
            <div class="glass-panel">
                <h3 style="margin-bottom: 1rem;">Recent Database Entries</h3>
                {% if recent_readings %}
                <div style="overflow-x: auto;">
                    <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem;">
                        <thead>
                            <tr style="border-bottom: 1px solid var(--glass-border); color: var(--text-muted);">
                                <th style="padding: 0.75rem 0.5rem;">Date</th>
                                <th style="padding: 0.75rem 0.5rem;">Soil Moist.</th>
                                <th style="padding: 0.75rem 0.5rem;">Air Temp</th>
                                <th style="padding: 0.75rem 0.5rem;">Canopy</th>
                                <th style="padding: 0.75rem 0.5rem;">Leaves</th>
                                <th style="padding: 0.75rem 0.5rem;">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for r in recent_readings %}
                            <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                                <td style="padding: 0.75rem 0.5rem;">{{ r.timestamp[:10] }}</td>
                                <td style="padding: 0.75rem 0.5rem;">{{ "%.1f"|format(r.soil_moisture_pct) }}%</td>
                                <td style="padding: 0.75rem 0.5rem;">{{ "%.1f"|format(r.temperature_c) }}°C</td>
                                <td style="padding: 0.75rem 0.5rem;">{{ "%.1f"|format(r.living_coverage_pct) }}%</td>
                                <td style="padding: 0.75rem 0.5rem;">{{ r.leaf_count|default(0) }}</td>
                                <td style="padding: 0.75rem 0.5rem;">
                                    <span style="padding: 0.2rem 0.5rem; border-radius: 4px; {% if r.status == 'alert' %}background-color: rgba(255,50,50,0.2); color: #ff6b6b;{% else %}background-color: rgba(50,255,50,0.2); color: #51cf66;{% endif %}">
                                        {{ r.status|default('normal')|title }}
                                    </span>
                                </td>
                            </tr>

                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% else %}
                <p style="color: var(--text-muted);">No records found. Generate data to see recent entries.</p>
                {% endif %}
            </div>
        </div>
